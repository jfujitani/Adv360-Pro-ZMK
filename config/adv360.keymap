#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        space_layer_access: space_layer_access {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_LAYER_ACCESS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-while-undecided;
            hold-trigger-on-release;
            retro-tap;
            hold-while-undecided-linger;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE        &kp N1    &kp N2          &kp N3           &kp N4   &kp N5  &tog 2                                                                         &mo 3      &kp N6  &kp N7  &kp N8            &kp N9    &kp N0          &kp MINUS
&kp TAB          &kp Q     &kp W           &kp E            &kp R    &kp T   &none                                                                          &none      &kp Y   &kp U   &kp I             &kp O     &kp P           &kp BSLH
&kp ESC          &kp A     &kp S           &kp D            &kp F    &kp G   &none     &kp LSHFT  &kp LEFT_CONTROL      &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &none      &kp H   &kp J   &kp K             &kp L     &kp SEMI        &kp SQT
&mt LSHFT EQUAL  &kp Z     &kp X           &kp C            &kp V    &kp B                        &kp LEFT_ALT          &kp RIGHT_ALT                                  &kp N   &kp M   &kp COMMA         &kp DOT   &kp FSLH        &mt RSHFT PAGE_UP
&mo 3            &kp HOME  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp END          &kp BSPC  &kp DEL    &kp LGUI              &kp RGUI           &kp ENTER        &kp SPACE          &kp UP  &kp LEFT_BRACKET  &kp LBKT  &kp DOWN_ARROW  &lt 3 PAGE_DOWN
            >;
        };

        Symbols {
            bindings = <
&kp GRAVE        &kp COMMA       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON     &kp PERIOD    &none                                                                    &none   &none  &none          &none             &none         &none         &none
&kp EXCLAMATION  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE   &kp QUESTION  &none                                                                    &none   &none  &kp LSHFT      &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none
&kp HASH         &kp CARET       &kp EQUAL             &kp MINUS              &kp DOLLAR        &kp ASTERISK  &none        &kp NON_US_BACKSLASH  &kp PERIOD            &trans  &trans  &none   &none  &kp BACKSPACE  &kp TAB           &kp SPACE     &kp ENTER     &none
&kp TILDE        &kp LESS_THAN   &kp PIPE              &kp UNDERSCORE         &kp GREATER_THAN  &kp SLASH                                        &kp RS(ASTERISK)      &trans                  &none  &kp DEL        &kp LS(TAB)       &none         &none         &none
&mo 3            &kp AMPERSAND   &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp PLUS                        &kp PERCENT  &kp COLON             &kp SEMICOLON         &trans  &trans  &trans         &trans         &trans            &trans        &trans        &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 5      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 5
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 2                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
